<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info" xmlns:smf="http://www.simplemachines.org/">
	<id>Bugo:GroupBuys</id>
	<name>Group Buys</name>
	<version>1.0</version>
	<type>modification</type>

	<install for="2.1.*">
		<require-dir name="Sources" destination="$boarddir" />
		<require-dir name="Themes" destination="$boarddir" />
		<hook hook="integrate_pre_load" function="GroupBuys::hooks#" file="$sourcedir/Class-GroupBuys.php" />
		<database>database.php</database>
	</install>

	<uninstall for="2.1.*">
		<hook hook="integrate_pre_load" function="GroupBuys::hooks#" file="$sourcedir/Class-GroupBuys.php" reverse="true" />
		<remove-file name="$sourcedir/Class-GroupBuys.php" />
		<remove-file name="$themedir/GroupBuys.template.php" />
		<remove-file name="$themedir/css/group_buys.css" />
		<remove-dir name="$languagedir/GroupBuys" />
		<redirect url="?action=admin;area=packages;sa=browse" timeout="1000" />
	</uninstall>

</package-info>